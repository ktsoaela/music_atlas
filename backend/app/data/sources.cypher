// King David Studio YouTube interviews — tier 3 oral history featuring artists already in the graph.
MERGE (s:Source {id:'src-curated-kds-ishmael-drugs'}) SET s.title="DRUGS South Africa's silent killer!", s.tier=3, s.provider='interview', s.url='https://youtu.be/8RfJpI0YFS0', s.excerpt='King David Studio interview with Ishmael Morabe on substance abuse in the SA music scene.';
MERGE (s:Source {id:'src-curated-kds-caiphus-1'}) SET s.title='I was a NAUGHTY BOY in Alex, Part 1 of 3', s.tier=3, s.provider='interview', s.url='https://youtu.be/WB1QIAC3tWg', s.excerpt='King David Studio interview with Caiphus Semenya on his Alexandra upbringing.';
MERGE (s:Source {id:'src-curated-kds-caiphus-2'}) SET s.title='Caiphus Semenya | My first job was backing vocalist for Miriam Makeba | Part 2 of 3', s.tier=3, s.provider='interview', s.url='https://youtu.be/thkQJiWQi10', s.excerpt='Semenya recounts starting his career as a backing vocalist for Miriam Makeba — corroborates the existing Semenya/Makeba graph link.';
MERGE (s:Source {id:'src-curated-kds-caiphus-3'}) SET s.title='Caiphus Semenya | Writing for Hugh Masekela, Miriam Makeba and working with Quincy Jones | Part 3', s.tier=3, s.provider='interview', s.url='https://youtu.be/r4phYTk2ZW0', s.excerpt='Semenya discusses writing for Masekela and Makeba and working with Quincy Jones — corroborates existing COLLABORATED_WITH edges.';
MERGE (s:Source {id:'src-curated-kds-spikiri-trompies'}) SET s.title='Mandla Spikiri Mofokeng | TROMPIES | KALAWAJAZMEE | KWAITO | MM DELUXE | FAMILY | UPBRINGING', s.tier=3, s.provider='interview', s.url='https://youtu.be/bui4qSy686c', s.excerpt='Spikiri on Trompies, Kalawa Jazmee and kwaito history. Note: names him Mandla Spikiri Mofokeng — verify against graph property a.name=\'Themba Mathebula\' on artist-spikiri, which may be an error.';
MERGE (s:Source {id:'src-curated-kds-thebe-kalawa'}) SET s.title="I'm the FIRST artist to sign to KALAWA | Thebe", s.tier=3, s.provider='interview', s.url='https://youtu.be/GJKqB2vscWM', s.excerpt='Thebe on being the first artist signed to Kalawa Jazmee.';
MERGE (s:Source {id:'src-curated-kds-skwatta-stoan'}) SET s.title="There's no greater CURSE than being BROKE AND FAMOUS!", s.tier=3, s.provider='interview', s.url='https://youtu.be/skgHUVcSXRo', s.excerpt='Stoan Seate of Skwatta Kamp on fame versus financial hardship in SA hip hop.';
MERGE (s:Source {id:'src-curated-kds-kelly'}) SET s.title='Kelly Khumalo | SPIRITUALITY | MENTAL HEALTH | FAMILY | MUSIC', s.tier=3, s.provider='interview', s.url='https://youtu.be/v8KI6J-ExOM', s.excerpt='Kelly Khumalo on spirituality, mental health, family and her music career.';
MERGE (s:Source {id:'src-curated-kds-jairus-nkwe'}) SET s.title='Jairus Nkwe | KALAWAJAZMEE | GOD | SPIKIRI | CHICCO TWALA | SOWETO', s.tier=3, s.provider='interview', s.url='https://youtu.be/HND_Oxh564g', s.excerpt='Jairus Nkwe interview mentioning Spikiri and Chicco Twala within the Kalawa Jazmee/Soweto scene — secondary mention, Nkwe himself not yet a graph node.';
MERGE (s:Source {id:'src-curated-kds-doc-shebeleza'}) SET s.title='Doc Shebeleza | UPBRINGING | KWAITO | MUSIC & MONEY | MANDLA SPIKIRI | MARRIAGE', s.tier=3, s.provider='interview', s.url='https://youtu.be/ySpwzgadGQw', s.excerpt='Doc Shebeleza interview mentioning Mandla Spikiri — secondary mention, Shebeleza himself not yet a graph node.';

