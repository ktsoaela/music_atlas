MERGE (a:Artist {id:'artist-sjava'}) SET a.name='Jabulani Hadebe', a.stage_name='Sjava', a.bio='Afro-soul singer, rapper and actor from Bergville, KZN, who built a national profile through TV roles before breaking through with Umama and Ambitiouz-era hits.', a.active_from=2015, a.languages=['Zulu','English'], a.roles=['singer','actor','songwriter'], a.generation=5;
MERGE (a:Artist {id:'artist-mapaputsi'}) SET a.name='Sandile Ebby Ngwenya', a.stage_name='Mapaputsi', a.bio='Zola-born kwaito artist who moved from gospel backing vocals into kwaito, breaking through with Izinja in 2001.', a.active_from=1998, a.active_to=2024, a.languages=['Zulu','English'], a.roles=['artist'], a.generation=3;
MERGE (a:Artist {id:'artist-lance-stehr'}) SET a.name='Lance Stehr', a.bio='Music industry executive who founded Ghetto Ruff Records, an independent SA label spanning kwaito, hip hop, soul, house and gospel.', a.active_from=1994, a.languages=['English'], a.roles=['label executive','producer'];
MERGE (a:Artist {id:'artist-mbongeni-ngema'}) SET a.name='Mbongeni Ngema', a.bio='Playwright, composer and director from Verulam, KZN, best known for Woza Albert! and Sarafina! — the latter co-written with Hugh Masekela — who shaped how apartheid-era struggle stories were told through music theatre.', a.active_from=1981, a.active_to=2023, a.languages=['Zulu','English'], a.roles=['composer','playwright','director'], a.generation=2;
MERGE (a:Artist {id:'artist-sizwe-zako'}) SET a.name='Sizwe Zako', a.bio='Self-taught pianist and producer from New Brighton, Gqeberha, called the architect of South African gospel and jazz for his work with Rebecca Malope, Vuyo Mokoena and Abigail Khubeka.', a.active_from=1980, a.languages=['Xhosa','English'], a.roles=['producer','pianist','artist'], a.generation=2;
MERGE (a:Artist {id:'artist-papa-penny'}) SET a.name='Giyani Nkovani', a.stage_name='Papa Penny', a.bio='Limpopo-born pioneer of Tsonga disco (Shangaan disco), fusing traditional Xitsonga rhythms with house and disco beats — breakthrough album Shaka Bundu (1994) went double platinum.', a.active_from=1994, a.languages=['Xitsonga','English'], a.roles=['artist'], a.generation=3;
MERGE (a:Artist {id:'artist-donald'}) SET a.name='Donald Moatshe', a.stage_name='Donald', a.bio='Rustenburg-born Afro-soul singer who broke through with I Deserve and the platinum album Love Train.', a.active_from=2008, a.languages=['Tswana','English'], a.roles=['singer','songwriter'], a.generation=5;

