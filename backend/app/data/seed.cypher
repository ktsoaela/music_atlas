MERGE (g:Genre {id:'genre-bacardi'}) SET g.name='Bacardi', g.era_start=2005;
MERGE (g:Genre {id:'genre-3-step'}) SET g.name='3-Step', g.era_start=2020;

MATCH (g:Genre {id:'genre-hip-hop'}), (p:Place {id:'township-cape-flats'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-kwaito'}), (p:Place {id:'city-johannesburg'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-gqom'}), (p:Place {id:'city-durban'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-amapiano'}), (p:Place {id:'city-johannesburg'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-lekompo'}), (p:Place {id:'province-limpopo'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-bolobedu-house'}), (p:Place {id:'region-bolobedu'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-tsa-manyalo'}), (p:Place {id:'province-limpopo'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-sesotho-contemporary'}), (p:Place {id:'country-lesotho'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-kwaito'}), (p:Genre {id:'genre-house'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-kwaito'}), (p:Genre {id:'genre-bubblegum'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-bubblegum'}), (p:Genre {id:'genre-mbaqanga'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-township-pop'}), (p:Genre {id:'genre-bubblegum'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-bacardi'}), (p:Place {id:'city-johannesburg'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-bacardi'}), (p:Genre {id:'genre-house'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-bacardi'}), (p:Genre {id:'genre-kwaito'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-amapiano'}), (p:Genre {id:'genre-deep-house'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-amapiano'}), (p:Genre {id:'genre-jazz'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-amapiano'}), (p:Genre {id:'genre-house'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-amapiano'}), (p:Genre {id:'genre-kwaito'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-amapiano'}), (p:Genre {id:'genre-bacardi'}) MERGE (g)-[:INFLUENCED_BY {note:'DJ culture and township house continuum'}]->(p);
MATCH (g:Genre {id:'genre-3-step'}), (p:Genre {id:'genre-amapiano'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-3-step'}), (p:Place {id:'city-johannesburg'}) MERGE (g)-[:ORIGINATED_IN]->(p);
MATCH (g:Genre {id:'genre-hip-hop'}), (p:Genre {id:'genre-kwaito'}) MERGE (g)-[:INFLUENCED_BY {note:'shared post-94 youth audiences and township clubs'}]->(p);
MATCH (g:Genre {id:'genre-gqom'}), (p:Genre {id:'genre-house'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-trap'}), (p:Genre {id:'genre-hip-hop'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-bolobedu-house'}), (p:Genre {id:'genre-house'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-tsa-manyalo'}), (p:Genre {id:'genre-bolobedu-house'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-lekompo'}), (p:Genre {id:'genre-tsa-manyalo'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-lekompo'}), (p:Genre {id:'genre-bolobedu-house'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-lekompo'}), (p:Genre {id:'genre-amapiano'}) MERGE (g)-[:INFLUENCED_BY {note:'shares dance-music DNA but remains a distinct Limpopo movement'}]->(p);
MATCH (g:Genre {id:'genre-sesotho-contemporary'}), (p:Genre {id:'genre-mbaqanga'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-afro-pop'}), (p:Genre {id:'genre-sesotho-contemporary'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-afro-pop'}), (p:Genre {id:'genre-bubblegum'}) MERGE (g)-[:INFLUENCED_BY]->(p);
MATCH (g:Genre {id:'genre-kwaito'}), (p:Genre {id:'genre-township-pop'}) MERGE (g)-[:INFLUENCED_BY]->(p);

MERGE (a:Artist {id:'artist-prophets-of-da-city'}) SET a.name='Prophets of Da City', a.stage_name='POC', a.bio='Pioneering Cape Town hip hop crew blending Afrikaans, English and political consciousness.', a.active_from=1988, a.languages=['English','Afrikaans'];
MERGE (a:Artist {id:'artist-black-noise'}) SET a.name='Black Noise', a.bio='Cape Flats hip hop collective led by Emile "YX?" Jansen — South Africa\'s oldest active hip-hop crew, performed at Mandela\'s 1994 inauguration.', a.active_from=1988, a.languages=['English','Afrikaans'];
MERGE (a:Artist {id:'artist-brasse-vannie-kaap'}) SET a.name='Brasse Vannie Kaap', a.stage_name='BVK', a.bio='Cape Flats Afrikaans hip hop group (Deon Daniels, Roger Heunis, Ashley Titus, Enver Pietersen) whose 1997 Ghetto Ruff debut, alongside Prophets of Da City, pioneered Afrikaans hip hop.', a.active_from=1996, a.languages=['Afrikaans'];
MERGE (a:Artist {id:'artist-godessa'}) SET a.name='Godessa', a.bio='All-women Cape Town hip hop crew (Shameema "Shame" Williams, EJ Von Lyrik, Burni Aman) — the first all-female SA hip hop group to sign a record deal (2002), debut album Spillage (2004).', a.active_from=2000, a.active_to=2008, a.languages=['English'];
MERGE (a:Artist {id:'artist-ishmael'}) SET a.name='Ishmael Morabe', a.stage_name='Ishmael', a.bio='Johannesburg lyricist bridging Cape conscious rap traditions with Gauteng hip hop.', a.active_from=1998, a.languages=['English','Zulu','Sotho'];
MERGE (a:Artist {id:'artist-prokid'}) SET a.name='Linda Mkhize', a.stage_name='ProKid', a.bio='Orlando, Soweto MC and storytelling force of 2000s SA hip hop — breakthrough single "Soweto" (2005), died 2018 after a seizure, post-mortem citing gastro-intestinal bleeding.', a.active_from=2002, a.active_to=2018, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-hhp'}) SET a.name='Jabulani Tsambo', a.stage_name='HHP', a.bio='Hip Hop Pantsula — Motswako pioneer mixing Setswana and English.', a.active_from=1997, a.active_to=2018, a.languages=['Setswana','English'];
MERGE (a:Artist {id:'artist-tkzee'}) SET a.name='TKZee', a.bio='Kwaito trio (Zwai Bala, Tokollo "Magesh" Tshabalala, Kabelo Mabalane) who defined late-90s Gauteng youth culture with "Shibobo" and the SAMA-winning album Halloween (1998), Tshabalala died in 2022.', a.active_from=1996, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-boom-shaka'}) SET a.name='Boom Shaka', a.bio='Kwaito group (Junior Sokhela, Lebo Mathosa, Theo Nhlengethwa, Thembi Seete) assembled by producer Don Laka in 1993 — debut single "It\'s About Time" and album Kwere Kwere (1994) became a face of post-apartheid youth expression.', a.active_from=1993, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-skwatta-kamp'}) SET a.name='Skwatta Kamp', a.bio='Johannesburg hip hop crew known for sharp lyricism and group chemistry.', a.active_from=1996, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-teargas'}) SET a.name='Teargas', a.bio='Hip hop trio (K.O, Ma-E, Ntukza) formed at Vaal Triangle Technikon — Wafa Wafa (2008) won Best Rap Album at the SAMAs.', a.active_from=2004, a.active_to=2014, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-zola'}) SET a.name='Bonginkosi Dlamini', a.stage_name='Zola', a.bio='Kwaito star, actor and township storyteller from the Zola section of Soweto — SAMA Artist of the Year (2002), scored and acted in the Oscar-winning film Tsotsi (2005), and hosted reality show Zola 7.', a.active_from=2000, a.languages=['Zulu'];
MERGE (a:Artist {id:'artist-cassper-nyovest'}) SET a.name='Refiloe Maele Phoolo', a.stage_name='Cassper Nyovest', a.bio='Rapper and entrepreneur from Mahikeng who scaled SA hip hop into arena culture — breakthrough album Tsholofelo (2014) and the "Fill Up" stadium concert franchise (2015-2019).', a.active_from=2013, a.languages=['English','Setswana'];
MERGE (a:Artist {id:'artist-aka'}) SET a.name='Kiernan Jarryd Forbes', a.stage_name='AKA', a.bio='Johannesburg rapper and producer central to 2010s commercial hip hop — breakthrough "Victory Lap" off Altar Ego (2011), shot dead outside a Durban restaurant in 2023, ruled an organised hit.', a.active_from=2010, a.active_to=2023, a.languages=['English'];
MERGE (a:Artist {id:'artist-kwesta'}) SET a.name='Senzo Mfundo Vilakazi', a.stage_name='Kwesta', a.bio='Katlehong ("K1") MC known for narrative street anthems — DaKAR II (2016) became SA hip hop\'s best-selling album, and "Ngiyaz\'fela Ngawe" was certified 11x Diamond.', a.active_from=2010, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-a-reece'}) SET a.name='Lehlogonolo Ronald Mataboge', a.stage_name='A-Reece', a.bio='Independent Pretoria lyricist with a devoted underground-to-mainstream following — broke out via Ambitiouz Entertainment (2015) before going independent and co-founding The Wrecking Crew (2017).', a.active_from=2013, a.languages=['English'];
MERGE (a:Artist {id:'artist-nasty-c'}) SET a.name='Nsikayesizwe David Junior Ngcobo', a.stage_name='Nasty C', a.bio='National star of modern SA rap and trap — born in Diepkloof, Soweto, and raised in Durban from infancy, debut album Bad Hair (2016) reached #1 on iTunes SA.', a.active_from=2014, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-tyson-sybateli'}) SET a.name='Tyson Sybateli', a.bio='New-generation lyricist continuing conscious and melodic SA hip hop threads — born in Umlazi, KwaZulu-Natal, raised and based in Pretoria, debut album Home (2022), signed to Sony Music Africa.', a.active_from=2019, a.languages=['English'];
MERGE (a:Artist {id:'artist-big-nuz'}) SET a.name='Big NUZ', a.bio='Durban house/gqom-adjacent group (Mampintsha, Danger, R Mashesha) founded 2002 in Umlazi that helped nationalise KZN dance music, Mampintsha died in 2022.', a.active_from=2008, a.languages=['Zulu'];
MERGE (a:Artist {id:'artist-dj-tira'}) SET a.name='Mthokozisi Khathi', a.stage_name='DJ Tira', a.bio='Durban DJ, label founder and dance-music kingpin — founded the Afrotainment label in 2007, launching acts including Big Nuz.', a.active_from=2005, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-professor'}) SET a.name='Mkhonzeni Langa', a.stage_name='Professor', a.bio='Durban vocalist and dance-music collaborator — rose via the duo Tzozo and Professor before debut solo album University of Kalawa Jazmee (2010) and hit single "Jezebel".', a.active_from=2008, a.languages=['Zulu'];
MERGE (a:Artist {id:'artist-distruction-boyz'}) SET a.name='Distruction Boyz', a.bio='Gqom production duo (Thobani "Que" Mgobhozi and Zipho "Goldmax" Mthembu) from KwaMashu who took the Durban sound international with the gold-certified album Gqom Is The Future (2017).', a.active_from=2015, a.languages=['Zulu'];
MERGE (a:Artist {id:'artist-babes-wodumo'}) SET a.name='Bongekile Mildred Simelane', a.stage_name='Babes Wodumo', a.bio='Gqom vocal star from Lamontville, Durban associated with the mid-2010s Durban explosion — debut album Gqom Queen, Vol. 1 (2016) and single "Wololo".', a.active_from=2016, a.languages=['Zulu'];
MERGE (a:Artist {id:'artist-blxckie'}) SET a.name='Sihle Philmon Sithole', a.stage_name='Blxckie', a.bio='Durban trap and melodic rap artist of the streaming era — gold-certified debut album B4Now (2021) and double-platinum single "Ye x4" ft. Nasty C.', a.active_from=2019, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-kabza-de-small'}) SET a.name='Kabelo Motha', a.stage_name='Kabza De Small', a.bio='Amapiano pioneer and prolific producer from Gauteng.', a.active_from=2016, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-dj-maphorisa'}) SET a.name='Themba Sekowe', a.stage_name='DJ Maphorisa', a.bio='Producer bridging house, afro pop and amapiano — founded label Blaqboy Music and co-produced Drake\'s "One Dance" (2016).', a.active_from=2010, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-uncle-waffles'}) SET a.name='Lungelihle Zwane', a.stage_name='Uncle Waffles', a.bio='Eswatini-born DJ who helped push amapiano onto global stages — viral single "Tanzania" (2022) and the first amapiano act to play Coachella (2023).', a.active_from=2021, a.languages=['English'];
MERGE (a:Artist {id:'artist-young-stunna'}) SET a.name='Sandile Fortune Msimango', a.stage_name='Young Stunna', a.bio='Amapiano vocalist from Daveyton known for anthemic collaborations — breakthrough "Bopha" (2021) and platinum debut album Notumato (2021).', a.active_from=2019, a.languages=['Zulu'];
MERGE (a:Artist {id:'artist-public-enemy'}) SET a.name='Public Enemy', a.bio='US hip hop group whose political style influenced early Cape Town MCs.', a.active_from=1985, a.languages=['English'];
MERGE (a:Artist {id:'artist-mfr-souls'}) SET a.name='MFR Souls', a.bio='Early Gauteng township production duo (Tumelo Nedondwe, Tumelo Mabe) from Katlehong who helped shape the amapiano template — platinum single "Love You Tonight" (2019).', a.active_from=2012, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-major-league-djz'}) SET a.name='Major League DJz', a.bio='DJ/producer twin duo (Bandile and Banele Mbere) central to amapiano club culture and national radio reach — signed to Atlantic Records in 2021.', a.active_from=2018, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-shebeshxt'}) SET a.name='Shebeshxt', a.bio='Limpopo artist associated with the rise of lekompo as a distinct regional sound.', a.active_from=2020, a.languages=['Northern Sotho','English'];
MERGE (a:Artist {id:'artist-kharishma'}) SET a.name='Kharishma', a.bio='Lekompo vocalist and collaborator in the Limpopo electronic dance scene.', a.active_from=2021, a.languages=['Northern Sotho'];
MERGE (a:Artist {id:'artist-janesh'}) SET a.name='Janesh', a.bio='Lekompo artist from the Limpopo movement.', a.active_from=2021, a.languages=['Northern Sotho'];
MERGE (a:Artist {id:'artist-naqua-sa'}) SET a.name='Naqua SA', a.bio='Producer/artist linked to lekompo and Limpopo dance music.', a.active_from=2020, a.languages=['Northern Sotho','English'];
MERGE (a:Artist {id:'artist-hitboss-sa'}) SET a.name='Hitboss SA', a.bio='Lekompo producer helping push the Limpopo sound onto national playlists.', a.active_from=2021, a.languages=['Northern Sotho','English'];
MERGE (a:Artist {id:'artist-sankomota'}) SET a.name='Sankomota', a.bio='Lesotho band whose pan-Southern African sound crossed into South Africa and beyond.', a.active_from=1976, a.languages=['Sesotho','English'];
MERGE (a:Artist {id:'artist-tsepo-tshola'}) SET a.name='Tsepo Tshola', a.stage_name='The Village Pope', a.bio='Lesotho-born singer of Sankomota whose voice shaped Sesotho contemporary music across borders.', a.active_from=1976, a.active_to=2021, a.languages=['Sesotho','English'];
MERGE (a:Artist {id:'artist-brenda-fassie'}) SET a.name='Brenda Fassie', a.stage_name='MaBrrr', a.bio='Queen of African Pop — Langa-born star who bridged bubblegum, township pop, Afro-pop and the democratic era.', a.active_from=1983, a.active_to=2004, a.languages=['Xhosa','English','Zulu'];
MERGE (a:Artist {id:'artist-big-dudes'}) SET a.name='Big Dudes', a.bio='Johannesburg band that launched Brenda Fassie — key bubblegum-era group.', a.active_from=1983, a.active_to=1987, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-chicco-twala'}) SET a.name='Sello Twala', a.stage_name='Chicco', a.bio='Producer-connector who bridged 1980s bubblegum into township dance and the kwaito era — hitmaker for Brenda Fassie and peer of Yvonne Chaka Chaka.', a.active_from=1980, a.languages=['Zulu','English'], a.roles=['producer','artist','songwriter'], a.generation=2;
MERGE (a:Artist {id:'artist-miriam-makeba'}) SET a.name='Miriam Makeba', a.stage_name='Mama Africa', a.bio='Global ambassador of African music — jazz, traditional and afro-pop voice of exile, the UN, and pan-African liberation.', a.active_from=1954, a.active_to=2008, a.languages=['Xhosa','English'], a.generation=1;
MERGE (a:Artist {id:'artist-hugh-masekela'}) SET a.name='Hugh Masekela', a.bio='Trumpeter who connected South African jazz to American jazz, Fela Kuti, and global festivals — exile-era musical connector.', a.active_from=1959, a.active_to=2018, a.languages=['English'], a.generation=1;
MERGE (a:Artist {id:'artist-caiphus-semenya'}) SET a.name='Caiphus Semenya', a.bio='Composer and producer who bridged South African songwriting to Hollywood and Quincy Jones — married to Letta Mbulu.', a.active_from=1960, a.languages=['Sotho','English'], a.generation=1;
MERGE (a:Artist {id:'artist-letta-mbulu'}) SET a.name='Letta Mbulu', a.bio='Jazz and soul voice of the exile generation — left South Africa in 1964, worked with Caiphus Semenya, Quincy Jones and Michael Jackson ("Liberian Girl"), and returned home in 1991.', a.active_from=1965, a.languages=['Xhosa','English'], a.generation=1;
MERGE (a:Artist {id:'artist-harry-belafonte'}) SET a.name='Harry Belafonte', a.bio='American singer and activist who helped introduce Miriam Makeba to global audiences — "Calypso" (1956) was the first million-selling LP by a solo artist, and he was a key strategist for Martin Luther King Jr.\'s civil rights movement.', a.active_from=1949, a.active_to=2023, a.languages=['English'], a.generation=1;
MERGE (a:Artist {id:'artist-quincy-jones'}) SET a.name='Quincy Jones', a.bio='American producer and composer who worked with Caiphus Semenya and Letta Mbulu — a Hollywood bridge for SA talent.', a.active_from=1951, a.languages=['English'], a.generation=1;
MERGE (a:Artist {id:'artist-fela-kuti'}) SET a.name='Olufela Olusegun Oludotun Ransome-Kuti', a.stage_name='Fela Kuti', a.bio='Nigerian afrobeat pioneer who shared stages and ideas with Hugh Masekela — founded the Kalakuta Republic commune, burned down by the Nigerian army in 1977.', a.active_from=1958, a.active_to=1997, a.languages=['Yoruba','English'], a.generation=1;
MERGE (a:Artist {id:'artist-paul-simon'}) SET a.name='Paul Frederic Simon', a.bio='American songwriter whose Graceland era linked SA musicians including Hugh Masekela and Miriam Makeba into global pop — the 1986 album, recorded in Johannesburg, sold 16M+ copies and won the 1988 Grammy for Record of the Year.', a.active_from=1957, a.languages=['English'], a.generation=2;
MERGE (a:Artist {id:'artist-herb-alpert'}) SET a.name='Herb Alpert', a.bio='American trumpeter who collaborated with Hugh Masekela — co-founded A&M Records (1962) and was inducted into the Rock and Roll Hall of Fame in 2006.', a.active_from=1957, a.languages=['English'], a.generation=1;
MERGE (a:Artist {id:'artist-yvonne-chaka-chaka'}) SET a.name='Yvonne Ntombizodwa Machaka', a.stage_name='Princess of Africa', a.bio='Bubblegum and Afro-pop peer of Brenda Fassie with lasting pan-African reach — "Umqombothi" featured in the opening scene of Hotel Rwanda (2004).', a.active_from=1981, a.languages=['Zulu','English'], a.generation=2;
MERGE (a:Artist {id:'artist-kelly-khumalo'}) SET a.name='Kelly Khumalo', a.bio='Afro-pop and maskandi-adjacent vocalist in the lineage of post-Fassie township pop.', a.active_from=2004, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-zahara'}) SET a.name='Bulelwa Mkutukana', a.stage_name='Zahara', a.bio='Guitarist-singer whose Afro-soul success continues the women-led SA pop lineage — double-platinum debut Loliwe (2011) and seventeen SAMAs, died 2023.', a.active_from=2011, a.active_to=2023, a.languages=['Xhosa','English'];
MERGE (a:Artist {id:'artist-arthur-mafokate'}) SET a.name='Arthur Mafokate', a.stage_name='King of Kwaito', a.bio='Kwaito pioneer who carried township dance energy from bubblegum and Chicco-era production into the 1990s — often called the King of Kwaito.', a.active_from=1993, a.languages=['Zulu','English'], a.roles=['artist','producer','pioneer'];
MERGE (a:Artist {id:'artist-mdu-masilela'}) SET a.name='Mduduzi Masilela', a.stage_name='Mdu', a.bio='Producer-architect of early kwaito — house-trained craftsman whose sound shaped Trompies, Mandoza and a generation of township dance producers.', a.active_from=1990, a.languages=['Zulu','English'], a.roles=['producer','artist','pioneer'], a.generation=3;
MERGE (a:Artist {id:'artist-trompies'}) SET a.name='Trompies', a.bio='Flagship kwaito group that popularised the sound through albums, dance and television — members include Spikiri, Mahoota, Jakarumba and Eugene Mthethwa.', a.active_from=1995, a.languages=['Zulu','English'], a.roles=['group'], a.generation=3;
MERGE (a:Artist {id:'artist-spikiri'}) SET a.name='Mandla Mofokeng', a.stage_name='Spikiri', a.bio='Trompies member, producer and solo force who carried kwaito into radio, TV and later collaborations.', a.active_from=1995, a.languages=['Zulu','English'], a.roles=['producer','artist','dj'], a.generation=3;
MERGE (a:Artist {id:'artist-mahoota'}) SET a.name='Zynne Sibika', a.stage_name='Mahoota', a.bio='Trompies member and kwaito vocal presence from the mid-1990s boom, from Meadowlands, Soweto — later half of the duo Vetkuk vs Mahoota.', a.active_from=1995, a.languages=['Zulu','English'], a.roles=['artist'], a.generation=3;
MERGE (a:Artist {id:'artist-jakarumba'}) SET a.name='Jairus Nkwe', a.stage_name='Jakarumba', a.bio='Trompies member known for dance and performance energy that helped sell kwaito to youth audiences.', a.active_from=1995, a.languages=['Zulu','English'], a.roles=['artist','choreographer'], a.generation=3;
MERGE (a:Artist {id:'artist-eugene-mthethwa'}) SET a.name='Eugene Mthethwa', a.stage_name='Donald Duck', a.bio='Trompies member whose career later moved into politics as an Economic Freedom Fighters Member of Parliament (sworn in 2023).', a.active_from=1995, a.languages=['Zulu','English'], a.roles=['artist'], a.generation=3;
MERGE (a:Artist {id:'artist-mandoza'}) SET a.name='Mduduzi Thembinkosi Edmund Tshabalala', a.stage_name='Mandoza', a.bio='Kwaito star whose hits and cross-over appeal took the genre to national stadiums and radio — signature album Nkalakatha (2000) sold 350,000 copies, died 2016 of pharyngeal cancer.', a.active_from=1990, a.active_to=2016, a.languages=['Zulu','English'], a.roles=['artist'], a.generation=3;
MERGE (a:Artist {id:'artist-brown-dash'}) SET a.name='Simphiwe Mpamile', a.stage_name='Brown Dash', a.bio='Kwaito artist of the late-90s / early-2000s Gauteng wave — "Umthandazo Wabolova" won Best Kwaito Album at the 2005 SAMAs, died 2012.', a.active_from=1998, a.active_to=2012, a.languages=['Zulu','English'], a.roles=['artist'], a.generation=3;
MERGE (a:Artist {id:'artist-thebe'}) SET a.name='Thebe', a.bio='Kwaito vocalist and songwriter who helped define the commercial kwaito sound.', a.active_from=1996, a.languages=['Zulu','English'], a.roles=['artist','songwriter'], a.generation=3;
MERGE (a:Artist {id:'artist-sbu-shabalala'}) SET a.name='Sibusiso Shabalala', a.stage_name="S'bu", a.bio='Artist linked to the Chicco township-dance production circle bridging late bubblegum into the 1990s.', a.active_from=1988, a.languages=['Zulu','English'], a.roles=['artist'], a.generation=2;
MERGE (a:Artist {id:'artist-jabu-khanyile'}) SET a.name='Jabu Khanyile', a.bio='Soweto vocalist and Bayete leader whose afro-jazz and pan-African sound won Kora Awards and stages with continental stars.', a.active_from=1974, a.active_to=2006, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-bayete'}) SET a.name='Bayete', a.bio='Afro-jazz and reggae band driven by Jabu Khanyile — later continued as Jabu Khanyile and Bayete.', a.active_from=1984, a.active_to=1992, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-the-daffodils'}) SET a.name='The Daffodils', a.bio='Early Soweto group where Jabu Khanyile began.', a.active_from=1970, a.languages=['Zulu','English'];
MERGE (a:Artist {id:'artist-the-editions'}) SET a.name='The Editions', a.bio='Reggae and soul covers band that Jabu Khanyile joined in 1974 as drummer then vocalist.', a.active_from=1974, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-the-movers'}) SET a.name='The Movers', a.bio='South African soul/funk band that Jabu Khanyile joined in 1977.', a.active_from=1967, a.languages=['English','Zulu'];
MERGE (a:Artist {id:'artist-youssou-ndour'}) SET a.name='Youssou NDour', a.bio='Senegalese star who shared international stages with Jabu Khanyile.', a.active_from=1975, a.languages=['Wolof','French','English'];
MERGE (a:Artist {id:'artist-angelique-kidjo'}) SET a.name='Angelique Kidjo', a.bio='Beninese singer and pan-African collaborator with Jabu Khanyile.', a.active_from=1980, a.languages=['Fon','French','English'];
MERGE (a:Artist {id:'artist-papa-wemba'}) SET a.name='Papa Wemba', a.bio='Congolese rumba star who performed with Jabu Khanyile on international circuits.', a.active_from=1969, a.active_to=2016, a.languages=['Lingala','French'];
MERGE (a:Artist {id:'artist-ringo-madlingozi'}) SET a.name='Sindile Madlingozi', a.stage_name='Ringo Madlingozi', a.bio='Eastern Cape vocalist known for Xhosa afro-pop and heartfelt ballads — rose to fame with band Peto before later serving as an EFF Member of Parliament (2019-2024).', a.active_from=1986, a.languages=['Xhosa','English'];
MERGE (a:Artist {id:'artist-simphiwe-dana'}) SET a.name='Simphiwe Dana', a.bio='Butterworth-born jazz and afro-soul singer who revived Xhosa lyricism in contemporary music — debut album Zandisile (2004) won Best Newcomer and Best Jazz Album.', a.active_from=2004, a.languages=['Xhosa','English'];
MERGE (a:Artist {id:'artist-thandiswa-mazwai'}) SET a.name='Thandiswa Nyameka Mazwai', a.stage_name='King Tha', a.bio='Vocalist from Bongo Maffin who bridged kwaito, Xhosa tradition and afro-soul — solo debut Zabalaza (2004) went double platinum.', a.active_from=1997, a.languages=['Xhosa','English','Zulu'];
MERGE (a:Artist {id:'artist-ami-faku'}) SET a.name='Amanda Faku', a.stage_name='Ami Faku', a.bio='Gqeberha singer blending afro-soul and contemporary SA pop — rose via The Voice SA (2017), debut album Imali (2019) went to number one and gold.', a.active_from=2017, a.languages=['Xhosa','English'];
MERGE (a:Artist {id:'artist-zolani-mahola'}) SET a.name='Zolani Mahola', a.stage_name='The One Who Sings', a.bio='Port Elizabeth-born vocalist who fronted Freshlyground (2002-2019), co-performing Shakira\'s 2010 World Cup anthem "Waka Waka", before launching a solo career in 2019.', a.active_from=2002, a.languages=['Xhosa','English'];
MERGE (a:Artist {id:'artist-freshlyground'}) SET a.name='Freshlyground', a.bio='Cape Town-based afro-fusion band with strong Eastern Cape vocal identity via Zolani Mahola — co-wrote and performed on Shakira\'s 2010 FIFA World Cup anthem "Waka Waka".', a.active_from=2002, a.active_to=2019, a.languages=['English','Xhosa'];
MERGE (a:Artist {id:'artist-vusi-mahlasela'}) SET a.name='Vusimuzi Sidney Mahlasela', a.stage_name='The Voice', a.bio='Mamelodi singer-songwriter whose folk and afro-jazz voice became a democracy-era soundtrack — taught himself guitar on a homemade instrument and performed at Mandela\'s 1994 inauguration.', a.active_from=1990, a.languages=['Northern Sotho','English'];
MERGE (a:Artist {id:'artist-bongo-maffin'}) SET a.name='Bongo Maffin', a.bio='Kwaito group founded by Zimbabwe-born DJ Jah Seed that launched Thandiswa Mazwai — debut album Leaders of D\'Gong (1997).', a.active_from=1996, a.languages=['Xhosa','Zulu','English'];

