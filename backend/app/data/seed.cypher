MERGE (g:Genre {id:'genre-hip-hop'}) SET g.name='Hip Hop', g.era_start=1988;
MERGE (g:Genre {id:'genre-kwaito'}) SET g.name='Kwaito', g.era_start=1993;
MERGE (g:Genre {id:'genre-gqom'}) SET g.name='Gqom', g.era_start=2010;
MERGE (g:Genre {id:'genre-amapiano'}) SET g.name='Amapiano', g.era_start=2012;
