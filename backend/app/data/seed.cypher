MERGE (e:Event {id:'event-1990-black-president'}) SET e.year=1990, e.title='Black President', e.description='Fassie song tied to Mandela and the late-apartheid / democracy transition.', e.kind='music', e.genre='Afro Pop', e.place='South Africa';
MERGE (e:Event {id:'event-2004-brenda'}) SET e.year=2004, e.title='Passing of Brenda Fassie', e.description='Queen of African Pop leaves a multi-genre legacy across township pop and Afro-pop.', e.kind='music', e.genre='Afro Pop', e.place='Johannesburg';
MERGE (e:Event {id:'event-1996-jabu-kora'}) SET e.year=1996, e.title='Jabu Khanyile wins Kora Award', e.description='Best Southern African artist recognition after Royal Gala appearance for Mandela.', e.kind='award', e.genre='Afro Jazz', e.place='Southern Africa';
MERGE (e:Event {id:'event-2006-jabu'}) SET e.year=2006, e.title='Passing of Jabu Khanyile', e.description='Bayete leader and pan-African collaborator remembered across the continent.', e.kind='music', e.genre='Afro Jazz', e.place='Soweto';
MERGE (e:Event {id:'event-1960-exile'}) SET e.year=1960, e.title='Sharpeville and the exile generation', e.description='Apartheid crackdown pushes musicians including Makeba, Masekela, Semenya and Mbulu into international exile — shaping global SA music.', e.kind='history', e.place='South Africa';
MERGE (e:Event {id:'event-1963-makeba-un'}) SET e.year=1963, e.title='Makeba addresses the United Nations', e.description='Miriam Makeba brings apartheid and African music to the world stage.', e.kind='history', e.place='United Nations';
MERGE (e:Event {id:'event-1986-graceland'}) SET e.year=1986, e.title='Graceland era', e.description='Paul Simon collaborations spotlight South African musicians globally amid cultural boycott debates.', e.kind='music', e.genre='World Music', e.place='Southern Africa';
MERGE (e:Event {id:'event-2008-makeba'}) SET e.year=2008, e.title='Passing of Miriam Makeba', e.description='Mama Africa leaves a pan-African and global musical legacy.', e.kind='music', e.genre='Afro Pop', e.place='Italy';
MERGE (e:Event {id:'event-2018-masekela'}) SET e.year=2018, e.title='Passing of Hugh Masekela', e.description='The musical connector of SA jazz to the world is remembered.', e.kind='music', e.genre='Afro Jazz', e.place='Johannesburg';

