MERGE (g:Genre {id:'genre-lekompo'}) SET g.name='Lekompo', g.era_start=2020;
MERGE (g:Genre {id:'genre-sesotho-contemporary'}) SET g.name='Sesotho Contemporary', g.era_start=1980;
MERGE (g:Genre {id:'genre-mbaqanga'}) SET g.name='Mbaqanga', g.era_start=1960;
MERGE (g:Genre {id:'genre-afro-jazz'}) SET g.name='Afro Jazz', g.era_start=1970;
MERGE (g:Genre {id:'genre-reggae'}) SET g.name='Reggae', g.era_start=1970;
MERGE (g:Genre {id:'genre-afro-soul'}) SET g.name='Afro Soul', g.era_start=2000;
MERGE (g:Genre {id:'genre-soul'}) SET g.name='Soul', g.era_start=1960;
MERGE (g:Genre {id:'genre-world'}) SET g.name='World Music', g.era_start=1980;
